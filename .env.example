# Azure OpenAI
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_API_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_API_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_API_DEPLOYMENT_NAME_MINI=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_API_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024

# Pinecone
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=quickstart
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_RERANK_MODEL=bge-reranker-v2-m3

STORAGE_PATH=./storage
METADATA_PATH=./data/documents.json

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=20
RERANK_TOP_N=10